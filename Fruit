local ValidFruitPositions = {}
local totalValidFruits = 0

local function CreateNoWaterESP(fruit)
    if not fruit:FindFirstChild("Fruit_ESP") then
        local targetPart = fruit:IsA("BasePart") and fruit or fruit:FindFirstChildWhichIsA("BasePart")
        if not targetPart then return end
        
        if targetPart.Position.Y < 0 then 
            return 
        end
        
        totalValidFruits = totalValidFruits + 1
        local fruitId = fruit:GetDebugId()
        ValidFruitPositions[fruitId] = targetPart.Position

        local rawName = fruit.Name:gsub(" Fruit", "")

        local bgu = Instance.new("BillboardGui")
        bgu.Name = "Fruit_ESP"
        bgu.Size = UDim2.new(0, 250, 0, 50)
