local function storeFruit(item)
    pcall(function()
        if item and item:IsA("Tool") then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local rawName = item.Name:gsub(" Fruit", "")
            
            if AllBloxFruits[rawName] or string.find(item.Name, "Fruit") then
                local uniqueId = item:GetDebugId()
                if not storedFruitsCache[uniqueId] then
                    if item.Parent == player.Backpack and humanoid then
                        humanoid:EquipTool(item)
                        task.wait(0.2)
                    end
                    if remoteComm then
                        remoteComm:InvokeServer("StoreFruit", AllBloxFruits[rawName] or (rawName .. "-" .. rawName), item)
                        sendDiscordWebhook(item.Name, uniqueId)
                    end
                end
            end
        end
    end)
end

local function storeAllOwnedFruits()
    pcall(function()
        if player.Character then
            for _, item in ipairs(player.Character:GetChildren()) do
                storeFruit(item)
            end
        end
        if player:FindFirstChild("Backpack") then
            for _, item in ipairs(player.Backpack:GetChildren()) do
                storeFruit(item)
            end
        end
    end)
end

local function autoPickAndStore()
    storeAllOwnedFruits()
    local foundValidFruit = false
    
    pcall(function()
        for _, obj in ipairs(Workspace:GetChildren()) do
            local rawName = obj.Name:gsub(" Fruit", "")
            if obj:IsA("Tool") and (AllBloxFruits[rawName] or string.find(obj.Name, "Fruit")) then
                local uniqueId = obj:GetDebugId()
                
                if not blacklistedFruits[uniqueId] then
                    local handle = obj:FindFirstChild("Handle")
                    local character = player.Character
                    if handle and character and character:FindFirstChild("HumanoidRootPart") then
                        if handle.Position.Y < 0 then
                            blacklistedFruits[uniqueId] = true
                            continue
                        end

                        local targetCFrame = handle.CFrame
                        foundValidFruit = true
                        
                        if moveType == "tween" then
                            StatusLabel.Text = "Tween: " .. obj.Name
                            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                            
                            local hrp = character:FindFirstChild("HumanoidRootPart")
                            local humanoid = character:FindFirstChildOfClass("Humanoid")
                            
                            if hrp and humanoid then
                                humanoid.PlatformStand = true
                                local startCFrame = hrp.CFrame
                                local distance = (startCFrame.Position - targetCFrame.Position).Magnitude
                                local speed = 300
                                local duration = distance / speed
                                local startTime = tick()
                                
                                local diedDuringTween = false
                                local charDeathConn
                                charDeathConn = humanoid.Died:Connect(function()
                                    diedDuringTween = true
                                    blacklistedFruits[uniqueId] = true
                                end)
                                
                                local conn
                                conn = RunService.Stepped:Connect(function()
                                    if not isRunning or not character:FindFirstChild("HumanoidRootPart") or not obj.Parent or humanoid.Health <= 0 then
                                        if conn then conn:Disconnect() end
                                        return
                                    end
                                    
                                    for _, part in ipairs(character:GetDescendants()) do
                                        if part:IsA("BasePart") then part.CanCollide = false end
                                    end
                                    
                                    local elapsed = tick() - startTime
                                    local alpha = math.clamp(elapsed / duration, 0, 1)
                                    hrp.CFrame = startCFrame:Lerp(targetCFrame, alpha)
                                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                    
                                    if alpha >= 1 or diedDuringTween then
                                        if conn then conn:Disconnect() end
                                    end
                                end)
                                
                                task.wait(duration)
                                if conn then conn:Disconnect() end
                                if charDeathConn then charDeathConn:Disconnect() end
                                humanoid.PlatformStand = false
                                
                                if diedDuringTween or humanoid.Health <= 0 then
                                    return 
                                end
                            end
                        else
                            StatusLabel.Text = "Fast TP: " .. obj.Name
                            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                            character.HumanoidRootPart.CFrame = targetCFrame
                            task.wait(0.15)
                        end
                        
                        storeAllOwnedFruits()
                        break
                    end
                end
            end
        end
    end)
    return foundValidFruit
end

