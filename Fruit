local function createInfoBox(name, defaultText, accentColor)
    local box = Instance.new("Frame")
    box.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
    box.BorderSizePixel = 0
    box.ZIndex = 2
    
    local boxStroke = Instance.new("UIStroke", box)
    boxStroke.Thickness = 1.2
    boxStroke.Color = accentColor or Color3.fromRGB(50, 50, 70)
    
    local corner = Instance.new("UICorner", box)
    corner.CornerRadius = UDim.new(0, 6)
    
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0.38, 0)
    title.BackgroundTransparency = 1
    title.Text = name
    title.TextColor3 = accentColor or Color3.fromRGB(200, 200, 220)
    title.TextSize = 9
    title.Font = Enum.Font.GothamBold
    title.ZIndex = 2
    title.Parent = box
    
    local value = Instance.new("TextLabel")
    value.Size = UDim2.new(1, 0, 0.62, 0)
    value.Position = UDim2.new(0, 0, 0.38, 0)
    value.BackgroundTransparency = 1
    value.Text = defaultText
    value.TextColor3 = Color3.fromRGB(255, 255, 255)
    value.TextSize = 10
    value.Font = Enum.Font.GothamBold
    value.ZIndex = 2
    value.Parent = box
    
    box.Parent = InfoContainer
    return value
end

