const express = require('express');
const mongoose = require('mongoose');
const app = express();

app.use(express.json());
app.use(express.urlencoded({ extended: true }));

// Kết nối MongoDB Atlas
const mongoURI = "mongodb+srv://phamthucdung04012012_db_user:Dung04/01/2012@cluster0.wurl4c5.mongodb.net/keymanager?retryWrites=true&w=majority&appName=Cluster0";

mongoose.connect(mongoURI)
  .then(() => console.log("MongoDB Connected Successfully!"))
  .catch(err => console.error("MongoDB Connection Error:", err));

// Schema chung cho Key
const keySchema = new mongoose.Schema({
    key: { type: String, required: true, unique: true },
    type: { type: String, required: true },
    discordId: { type: String, required: true },
    hwid: { type: String, default: 'None' },
    disabled: { type: Boolean, default: false },
    extra: { type: String, default: 'Lifetime' },
    createdAt: { type: Date, default: Date.now }
});

const KeyModel = mongoose.model('KeyData', keySchema);

// API Tạo Key Premium
app.post('/api/admin/create-premium', async (req, res) => {
    try {
        const { discordId } = req.body;
        if (!discordId) return res.json({ status: 'error', message: 'Thiếu Discord ID!' });
        
        const randomKey = 'DUBO-PREMIUM-' + Math.random().toString(36).substring(2, 10).toUpperCase();
        
        const newKeyDoc = new KeyModel({
            key: randomKey,
            type: 'PREMIUM',
            discordId: discordId.trim(),
            hwid: 'None',
            disabled: false,
            extra: 'Lifetime'
        });
        
        await newKeyDoc.save();
        res.json({ status: 'success', key: randomKey });
    } catch (e) {
        res.json({ status: 'error', message: e.message });
    }
});

// API Tạo Key Thời Gian
app.post('/api/admin/create-time', async (req, res) => {
    try {
        const { discordId, duration } = req.body;
        if (!discordId || !duration) return res.json({ status: 'error', message: 'Thiếu thông tin!' });
        
        const randomKey = 'DUBO-TIME-' + Math.random().toString(36).substring(2, 10).toUpperCase();
        
        const newKeyDoc = new KeyModel({
            key: randomKey,
            type: 'TIME',
            discordId: discordId.trim(),
            hwid: 'None',
            disabled: false,
            extra: duration
        });
        
        await newKeyDoc.save();
        res.json({ status: 'success', key: randomKey });
    } catch (e) {
        res.json({ status: 'error', message: e.message });
    }
});

// API Tìm kiếm key trực tiếp
app.post('/api/admin/search-keys', async (req, res) => {
    try {
        const { keyword } = req.body;
        let query = {};
        
        if (keyword && keyword.trim() !== '') {
            query.$or = [
                { key: { $regex: keyword.trim(), $options: 'i' } },
                { discordId: { $regex: keyword.trim(), $options: 'i' } }
            ];
        }
        
        const foundKeys = await KeyModel.find(query).limit(50);
        res.json({ status: 'success', keys: foundKeys });
    } catch (e) {
        res.json({ status: 'error', message: e.message });
    }
});

// API Quản lý key (Xóa, Reset HWID, Vô hiệu hóa)
app.post('/api/admin/manage-key', async (req, res) => {
    try {
        const { key, action, confirmText } = req.body;
        const targetKey = await KeyModel.findOne({ key });

        if (!targetKey) return res.json({ status: 'error', message: 'Không tìm thấy key trên server!' });

        if (action === 'delete') {
            if (confirmText !== 'DELETE KEY') return res.json({ status: 'error', message: 'Sai chữ xác nhận!' });
            await KeyModel.deleteOne({ key });
        } else if (action === 'reset_hwid') {
            if (confirmText !== 'RESET HWID') return res.json({ status: 'error', message: 'Sai chữ xác nhận!' });
            targetKey.hwid = 'None';
            await targetKey.save();
        } else if (action === 'neutralize') {
            let reqText = targetKey.disabled ? 'TO REMOVE' : 'TO NEUTRALIZE';
            if (confirmText !== reqText) return res.json({ status: 'error', message: 'Sai chữ xác nhận!' });
            
            if (targetKey.disabled) {
                await KeyModel.deleteOne({ key });
            } else {
                targetKey.disabled = true;
                await targetKey.save();
            }
        }

        res.json({ status: 'success' });
    } catch (e) {
        res.json({ status: 'error', message: e.message });
    }
});

// Giao diện web chính cực kỳ đẹp mắt, tối ưu mobile và mượt mà
app.get('*', (req, res) => {
    res.setHeader('Content-Type', 'text/html; charset=utf-8');
    res.send(`<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DUBO HUB - Secure Management</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background: radial-gradient(circle at center, #0f172a, #020617); color: #f8fafc; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 15px; overflow-x: hidden; }
        .container { width: 100%; max-width: 800px; background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(12px); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: 20px; padding: 25px; box-shadow: 0 0 40px rgba(14, 165, 233, 0.15); text-align: center; position: relative; }
        
        /* Menu Button */
        .menu-btn { position: absolute; top: 20px; left: 20px; background: linear-gradient(135deg, #0284c7, #0369a1); border: none; color: #fff; width: 42px; height: 42px; border-radius: 10px; cursor: pointer; font-size: 20px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3); transition: 0.2s; z-index: 100; }
        .menu-btn:active { transform: scale(0.92); }

        /* Sidebar */
        .sidebar-menu { position: fixed; top: 0; left: -300px; width: 280px; height: 100%; background: #020617; border-right: 1px solid rgba(56, 189, 248, 0.2); transition: 0.35s cubic-bezier(0.4, 0, 0.2, 1); z-index: 99; display: flex; flex-direction: column; padding-top: 80px; text-align: left; box-shadow: 10px 0 30px rgba(0,0,0,0.8); }
        .sidebar-menu.active { left: 0; }
        .menu-item { padding: 16px 22px; color: #7dd3fc; border-bottom: 1px solid rgba(255,255,255,0.05); cursor: pointer; font-weight: 600; font-size: 14px; transition: 0.2s; display: flex; align-items: center; gap: 10px; }
        .menu-item:hover { background: rgba(56, 189, 248, 0.1); color: #fff; padding-left: 26px; }

        /* Profile & Header */
        .avatar-box img { width: 90px; height: 90px; border-radius: 50%; border: 3px solid #38bdf8; box-shadow: 0 0 25px rgba(56, 189, 248, 0.4); margin-bottom: 12px; object-fit: cover; }
        .brand-title { font-size: 28px; font-weight: 800; letter-spacing: 3px; background: linear-gradient(90deg, #38bdf8, #818cf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 5px; }
        .aura-text { font-size: 13px; color: #2dd4bf; text-shadow: 0 0 12px rgba(45, 212, 191, 0.5); min-height: 25px; margin-bottom: 25px; font-family: monospace; }

        /* Sections */
        .section { background: rgba(30, 41, 59, 0.5); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 14px; padding: 20px; margin-bottom: 15px; text-align: left; display: none; backdrop-filter: blur(5px); }
        .section.active-tab { display: block; animation: fadeIn 0.3s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
        
        .section h3 { color: #38bdf8; margin-bottom: 14px; font-size: 16px; font-weight: 700; letter-spacing: 0.5px; }
        .control-row { display: flex; gap: 10px; align-items: center; margin-bottom: 12px; width: 100%; }
        
        input[type="text"] { width: 100%; flex: 1; padding: 12px 14px; background: #020617; border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 10px; color: #fff; outline: none; font-size: 14px; transition: 0.2s; }
        input[type="text"]:focus { border-color: #38bdf8; box-shadow: 0 0 10px rgba(56, 189, 248, 0.2); }
        
        button { padding: 12px 18px; border: none; border-radius: 10px; font-weight: 700; cursor: pointer; white-space: nowrap; font-size: 14px; transition: 0.2s; }
        button:active { transform: scale(0.96); }
        .btn-success { background: linear-gradient(135deg, #10b981, #059669); color: white; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); }
        .btn-danger { background: linear-gradient(135deg, #ef4444, #dc2626); color: white; }
        .btn-warning { background: linear-gradient(135deg, #f59e0b, #d97706); color: white; }
        .btn-primary { background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; }

        /* Switch System */
        .switch-container { display: flex; justify-content: space-between; align-items: center; background: #020617; padding: 15px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.05); }
        .switch { position: relative; display: inline-block; width: 54px; height: 30px; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #334155; transition: .3s; border-radius: 30px; }
        .slider:before { position: absolute; content: ""; height: 22px; width: 22px; left: 4px; bottom: 4px; background-color: white; transition: .3s; border-radius: 50%; }
        input:checked + .slider { background-color: #10b981; }
        input:checked + .slider:before { transform: translateX(24px); }

        /* Search & Results */
        .result-box { margin-top: 12px; background: #020617; padding: 12px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.08); font-size: 13px; max-height: 280px; overflow-y: auto; word-break: break-all; }
        .key-item { padding: 10px; border-bottom: 1px solid rgba(255,255,255,0.05); cursor: pointer; border-radius: 6px; transition: 0.2s; margin-bottom: 4px; }
        .key-item:hover { background: rgba(56, 189, 248, 0.08); }
        .key-details { display: none; margin-top: 10px; padding: 10px; background: #0f172a; border-radius: 8px; border: 1px solid rgba(56, 189, 248, 0.2); }
        .action-box { margin-top: 8px; display: flex; gap: 8px; align-items: center; }
        .success-alert { color: #34d399; font-weight: bold; margin-top: 10px; display: none; font-size: 13px; background: rgba(16, 185, 129, 0.1); padding: 8px; border-radius: 6px; border: 1px solid rgba(16, 185, 129, 0.3); }
    </style>
</head>
<body>
    <div class="container">
        <button class="menu-btn" onclick="toggleMenu()">☰</button>
        
        <div class="sidebar-menu" id="sidebarMenu">
            <div class="menu-item" onclick="switchTab('tabKey')">🔑 Kho Key & Tìm Kiếm</div>
            <div class="menu-item" onclick="switchTab('tabCreatePremium')">➕ Tạo Key Premium</div>
            <div class="menu-item" onclick="switchTab('tabCreateTime')">⏳ Tạo Key Thời Gian</div>
            <div class="menu-item" onclick="switchTab('tabSystem')">⚙️ System Control</div>
        </div>

        <div class="avatar-box">
            <img src="https://cdn.discordapp.com/attachments/1530612413966188584/1544230813690757260/IMG_1109.png?ex=6a97c084&is=6a966f04&hm=859498894699993427601e70647d9489c873b557f711536d9fa1f3bf862c489d&" alt="Avatar">
        </div>
        <div class="brand-title">DUBO HUB</div>
        <div><span class="aura-text" id="typedText"></span></div>

        <!-- Tab Kho Key & Tìm Kiếm -->
        <div id="tabKey" class="section active-tab">
            <h3>TRA CỨU & QUẢN LÝ KEY</h3>
            <div class="control-row">
                <input type="text" id="searchKeyword" placeholder="Nhập mã Key hoặc Discord ID để tìm..." oninput="searchKeys()">
            </div>
            <div class="result-box" id="searchResult">
                <span style="color: #64748b;">Nhập từ khóa để tra cứu trực tiếp từ Database...</span>
            </div>
        </div>

        <!-- Tab Tạo Key Premium -->
        <div id="tabCreatePremium" class="section">
            <h3>TẠO KEY PREMIUM MỚI</h3>
            <div class="control-row">
                <input type="text" id="targetDiscordIdPrem" placeholder="Nhập Discord ID của người dùng...">
            </div>
            <div class="control-row">
                <input type="text" id="generatedKeyFieldPrem" placeholder="Key sẽ hiển thị ở đây..." readonly>
                <button class="btn-success" onclick="generateKey('premium')">Tạo Key</button>
            </div>
            <div class="success-alert" id="createSuccessAlertPrem">✨ Đã tạo và lưu thành công vào MongoDB Atlas!</div>
        </div>

        <!-- Tab Tạo Key Thời Gian -->
        <div id="tabCreateTime" class="section">
            <h3>TẠO KEY THỜI GIAN MỚI</h3>
            <div class="control-row">
                <input type="text" id="targetDiscordIdTime" placeholder="Nhập Discord ID của người dùng...">
            </div>
            <div class="control-row">
                <input type="text" id="durationInput" placeholder="Thời gian (VD: 24h, 7d, 30d)...">
            </div>
            <div class="control-row">
                <input type="text" id="generatedKeyFieldTime" placeholder="Key sẽ hiển thị ở đây..." readonly>
                <button class="btn-success" onclick="generateKey('time')">Tạo Key</button>
            </div>
            <div class="success-alert" id="createSuccessAlertTime">✨ Đã tạo và lưu thành công vào MongoDB Atlas!</div>
        </div>

        <!-- Tab System Control -->
        <div id="tabSystem" class="section">
            <h3>HỆ THỐNG ĐIỀU KHIỂN CHÍNH</h3>
            <div class="switch-container">
                <span id="statusText" style="color: #34d399; font-weight: bold; font-size: 14px;">System is ONLINE</span>
                <label class="switch">
                    <input type="checkbox" id="mainSystemSwitch" checked onchange="toggleSystem()">
                    <span class="slider"></span>
                </label>
            </div>
        </div>
    </div>

    <script>
        window.onload = function() { startTypingEffect(); searchKeys(); };
        
        function toggleMenu() { 
            document.getElementById("sidebarMenu").classList.toggle("active"); 
        }

        function switchTab(tabId) {
            document.querySelectorAll('.section').forEach(t => t.classList.remove('active-tab'));
            document.getElementById(tabId).classList.add('active-tab');
            toggleMenu();
        }

        const textToType = "CHÀO MỪNG ĐẾN VỚI HỆ THỐNG DUBO HUB";
        let charIndex = 0;
        function startTypingEffect() {
            function type() {
                if (charIndex < textToType.length) {
                    document.getElementById("typedText").innerHTML += textToType.charAt(charIndex);
                    charIndex++;
                    setTimeout(type, 90);
                }
            }
            type();
        }

        async function generateKey(type) {
            let discordId, endpoint, fieldId, alertId, payload;
            if (type === 'premium') {
                discordId = document.getElementById("targetDiscordIdPrem").value.trim();
                endpoint = '/api/admin/create-premium';
                fieldId = "generatedKeyFieldPrem";
                alertId = "createSuccessAlertPrem";
                payload = { discordId: discordId };
            } else {
                discordId = document.getElementById("targetDiscordIdTime").value.trim();
                let duration = document.getElementById("durationInput").value.trim();
                endpoint = '/api/admin/create-time';
                fieldId = "generatedKeyFieldTime";
                alertId = "createSuccessAlertTime";
                payload = { discordId: discordId, duration: duration };
                if (!duration) { alert("Vui lòng nhập thời gian!"); return; }
            }
            if (!discordId) { alert("Vui lòng nhập Discord ID!"); return; }
            try {
                let res = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                let data = await res.json();
                if(data.status === 'success') {
                    document.getElementById(fieldId).value = data.key;
                    let alertBox = document.getElementById(alertId);
                    alertBox.style.display = "block";
                    setTimeout(() => { alertBox.style.display = "none"; }, 4000);
                } else { alert("Lỗi: " + data.message); }
            } catch(e) { alert("Không kết nối được server!"); }
        }

        async function searchKeys() {
            let keyword = document.getElementById("searchKeyword").value.trim();
            let resultBox = document.getElementById("searchResult");
            try {
                let res = await fetch('/api/admin/search-keys', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ keyword: keyword })
                });
                let data = await res.json();
                if(data.status === 'success') {
                    if(data.keys.length === 0) {
                        resultBox.innerHTML = '<span style="color: #fbbf24;">Không tìm thấy key phù hợp!</span>';
                    } else {
                        let html = '<b style="color: #34d399;">Tìm thấy ' + data.keys.length + ' kết quả:</b><br><br>';
                        data.keys.forEach((item, index) => {
                            let typeBadge = item.type === 'PREMIUM' ? '<span style="color: #38bdf8;">[PREMIUM]</span>' : '<span style="color: #fbbf24;">[TIME]</span>';
                            let statusBadge = item.disabled ? '<span style="color: #f87171;">[Đã khóa]</span>' : '<span style="color: #34d399;">[Hoạt động]</span>';
                            let neutralizeText = item.disabled ? 'TO REMOVE' : 'TO NEUTRALIZE';
                            html += '<div class="key-item" onclick="toggleKeyDetails(' + index + ')">' +
                                '<div><b>' + (index + 1) + '. ' + item.key + '</b> ' + typeBadge + ' ' + statusBadge + '</div>' +
                                '<div style="font-size: 11px; color: #94a3b8; margin-top: 3px;">Discord ID: ' + item.discordId + ' | Info: ' + item.extra + ' | HWID: ' + item.hwid + '</div>' +
                                '<div class="key-details" id="details-' + index + '" onclick="event.stopPropagation()">' +
                                '<div style="font-size: 12px; margin-bottom: 6px; color: #60a5fa;">Hành động quản trị:</div>' +
                                '<div class="action-box"><input type="text" id="input-del-' + index + '" placeholder="Gõ: DELETE KEY"><button class="btn-danger" onclick="manageKey(\\'' + item.key + '\\', \\'delete\\', \\'input-del-' + index + '\\', \\'DELETE KEY\\')">Xóa</button></div>' +
                                '<div class="action-box"><input type="text" id="input-reset-' + index + '" placeholder="Gõ: RESET HWID"><button class="btn-warning" onclick="manageKey(\\'' + item.key + '\\', \\'reset_hwid\\', \\'input-reset-' + index + '\\', \\'RESET HWID\\')">Reset HWID</button></div>' +
                                '<div class="action-box"><input type="text" id="input-neu-' + index + '" placeholder="Gõ: ' + neutralizeText + '"><button class="btn-primary" onclick="manageKey(\\'' + item.key + '\\', \\'neutralize\\', \\'input-neu-' + index + '\\', \\'' + neutralizeText + '\\')">' + neutralizeText + '</button></div>' +
                                '</div></div>';
                        });
                        resultBox.innerHTML = html;
                    }
                } else { resultBox.innerHTML = '<span style="color: #f87171;">Lỗi từ server!</span>'; }
            } catch(e) { resultBox.innerHTML = '<span style="color: #f87171;">Lỗi kết nối server!</span>'; }
        }

        function toggleKeyDetails(index) {
            let el = document.getElementById('details-' + index);
            el.style.display = (el.style.display === 'block') ? 'none' : 'block';
        }

        async function manageKey(keyStr, actionType, inputId, requiredText) {
            let userTyped = document.getElementById(inputId).value.trim();
            if(userTyped !== requiredText) { alert('Phải gõ chính xác "' + requiredText + '" để xác nhận!'); return; }
            try {
                let res = await fetch('/api/admin/manage-key', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ key: keyStr, action: actionType, confirmText: userTyped })
                });
                let data = await res.json();
                if(data.status === 'success') { alert("Thành công!"); searchKeys(); }
                else { alert("Lỗi: " + data.message); }
            } catch(e) { alert("Lỗi kết nối!"); }
        }

        function toggleSystem() {
            let isChecked = document.getElementById("mainSystemSwitch").checked;
            let statusText = document.getElementById("statusText");
            if(isChecked) { statusText.innerText = "System is ONLINE"; statusText.style.color = "#34d399"; }
            else { statusText.innerText = "System is OFFLINE"; statusText.style.color = "#f87171"; }
        }
    </script>
</body>
</html>`);
});

module.exports = app;
