3. File: api/check-key.js (Tạo thư mục tên "api", tạo file "check-key.js" bên trong)
--------------------------------------------------------------------------------
const { MongoClient } = require('mongodb');
const crypto = require('crypto');

const uri = process.env.MONGODB_URI;
const SECRET_AUTH_TOKEN = process.env.SECRET_AUTH_TOKEN;
let cachedClient = null;

async function connectToDatabase() {
  if (cachedClient) return cachedClient;
  if (!uri) throw new Error("Loi: Thieu bien moi truong MONGODB_URI tren Vercel!");
  const client = new MongoClient(uri);
  await client.connect();
  cachedClient = client;
  return client;
}

function generateUniqueKey() {
  return `DUBO-KEY=${crypto.randomBytes(6).toString('hex').toUpperCase()}`;
}

module.exports = async (req, res) => {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization');

  if (req.method === 'OPTIONS') return res.status(200).end();
  if (req.method !== 'POST') return res.status(405).json({ status: 'error', message: 'Chi chap nhan duy nhat POST!' });

  const authHeader = req.headers['authorization'];
  if (!authHeader || authHeader !== `Bearer ${SECRET_AUTH_TOKEN}`) {
    return res.status(401).json({ status: 'error', message: 'Truy cap bi tu choi! Server nay khong cong khai.' });
  }

  const { action, hwid, key } = req.body;

  try {
    const client = await connectToDatabase();
    const db = client.db('keymanager'); 
    const tempCollection = db.collection('temp_keys'); // Kho tạm (2 tiếng)
    const mainCollection = db.collection('main_keys'); // Kho chính (24 tiếng)

    // [HÀNH ĐỘNG 1]: CLICK GET KEY -> TẠO KEY KHÔNG TRÙNG & LƯU KHO TẠM
    if (action === 'generate') {
      if (!hwid) return res.status(400).json({ status: 'error', message: 'Yeu cau thieu thong tin HWID!' });
      let newKey;
      let isDuplicate = true;

      while (isDuplicate) {
        newKey = generateUniqueKey();
        const checkTemp = await tempCollection.findOne({ key: newKey });
        const checkMain = await mainCollection.findOne({ key: newKey });
        if (!checkTemp && !checkMain) isDuplicate = false;
      }

      await tempCollection.updateOne(
        { hwid: hwid },
        { $set: { key: newKey, createdAt: new Date() } },
        { upsert: true }
      );
      return res.status(200).json({ status: 'success', key: newKey });
    }

    // [HÀNH ĐỘNG 2]: ẤN SUMMIT -> DUYỆT TỪ KHO TẠM SANG KHO CHÍNH (24H)
    if (action === 'submit') {
      if (!hwid || !key) return res.status(400).json({ status: 'error', message: 'Thieu HWID hoac chuoi Key!' });
      const tempRecord = await tempCollection.findOne({ hwid: hwid, key: key });

      if (!tempRecord) {
        return res.status(403).json({ status: 'failed', message: 'Key sai hoac da qua han 2 tieng!' });
      }

      await tempCollection.deleteOne({ _id: tempRecord._id });
      const expireAt = new Date();
      expireAt.setHours(expireAt.getHours() + 24);

      await mainCollection.updateOne(
        { hwid: hwid },
        { $set: { key: key, expireAt: expireAt, createdAt: new Date() } },
        { upsert: true }
      );
      return res.status(200).json({ status: 'success', message: 'Duyet key thanh cong! Ban co 24 gio su dung.' });
    }

    // [HÀNH ĐỘNG 3]: MỞ SCRIPT -> QUÉT SỰ TỒN TẠI & THỜI GIAN CỦA HWID
    if (action === 'check_status') {
      if (!hwid) return res.status(400).json({ status: 'error', message: 'Yeu cau thieu thong tin HWID!' });
      const mainRecord = await mainCollection.findOne({ hwid: hwid });

      if (!mainRecord) {
        return res.status(404).json({ status: 'expired', message: 'Key khong ton tai hoac het han!' });
      }

      const timeLeft = mainRecord.expireAt - new Date();
      if (timeLeft <= 0) {
        await mainCollection.deleteOne({ hwid: hwid });
        return res.status(404).json({ status: 'expired', message: 'Thoi han su dung key da ket thuc!' });
      }

      const hoursLeft = Math.floor(timeLeft / (1000 * 60 * 60));
      const minsLeft = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
      return res.status(200).json({ 
        status: 'active', 
        timeLeft: `${hoursLeft} gio ${minsLeft} phut`
      });
    }

    return res.status(400).json({ status: 'error', message: 'Hanh dong gui len khong hop le!' });
  } catch (error) {
    return res.status(500).json({ status: 'error', message: 'Loi he thong xu ly phia Server!', details: error.message });
  }
};


================================================================================
PHẦN 2: MÃ NGUỒN PHÍA SCRIPT GAME (Ngôn ngữ Luau / Roblox Executor)
================================================================================

local HttpService = game:GetService("HttpService")
local LinkedHWID = game:GetService("RbxAnalyticsService"):GetClientId()
local WorkspaceFileName = "DUBO_KeyAuth.txt"

-- CẤU HÌNH LIÊN KẾT ĐẾN SERVER VERCEL CỦA BẠN
local ServerURL = "https://vercel.app" -- Dán link Vercel của bạn vào đây
local SecretToken = "Bearer DUNG_DUBO_2026" -- Dán TOKEN bảo mật đã cài ở Vercel vào đây

local function sendRequest(actionType, inputKey)
    local success, response = pcall(function()
        return request({
            Url = ServerURL,
            Method = "POST",
            Headers = {
                ["Authorization"] = SecretToken,
                ["Content-Type"] = "application/json"
            },
            Body = HttpService:JSONEncode({
                action = actionType,
                hwid = LinkedHWID,
                key = inputKey
            })
        })
    end)
    if success and response.StatusCode == 200 then
        return HttpService:JSONDecode(response.Body)
    else
        return nil
    end
end

-- HÀM CHÍNH 1: QUÉT NHANH WORKSPACE KHI BẬT SCRIPT TRONG VÒNG 24H
local function checkSavedKey()
    if isfile(WorkspaceFileName) then
        local savedKey = readfile(WorkspaceFileName)
        local result = sendRequest("check_status", savedKey)
        if result and result.status == "active" then
            print("🔑 Khớp dữ liệu thành công! Thời gian còn lại: " .. result.timeLeft)
            -- [KÍCH HOẠT SCRIPT CHÍNH CỦA BẠN TẠI ĐÂY]
            return true
        else
            print("❌ Key cũ hết hiệu lực trên server. Đang xóa file tạm khỏi workspace...")
            delfile(WorkspaceFileName)
        end
    end
    return false
end

-- HÀM CHÍNH 2: LOGIC KHI NGƯỜI DÙNG TƯƠNG TÁC GIAO DIỆN (UI)
local function startKeySystem()
    if checkSavedKey() then return end
    
    print("--- HỆ THỐNG YÊU CẦU DUYỆT KEY ---")

    -- [SỰ KIỆN 1]: KHI NGƯỜI DÙNG ẤN NÚT "GET KEY" TRÊN UI
    -- NútGetKey.MouseButton1Click:Connect(function()
        local response = sendRequest("generate", nil)
        if response and response.key then
            local linkGetKey = "https://authtool.app" .. response.key
            setclipboard(linkGetKey)
            print("🔗 Đã copy link authtool chứa mã key vào Clipboard!")
        else
            print("❌ Không thể kết nối server để đúc key tạm.")
        end
    -- end)

    -- [SỰ KIỆN 2]: KHI NGƯỜI DÙNG DÁN KEY VÀO Ô NHẬP VÀ ẤN NÚT "SUBMIT"
    -- NútSubmit.MouseButton1Click:Connect(function()
        local userEnteredKey = "DUBO-KEY-XU-LY-TU-UI" -- Lấy text từ TextBox trên UI của bạn
        local submitResult = sendRequest("submit", userEnteredKey)
        
        if submitResult and submitResult.status == "success" then
            print("✅ Key chuẩn xác! Lưu vào workspace thông hành nhanh cho lần sau.")
            writefile(WorkspaceFileName, userEnteredKey)
            -- [KÍCH HOẠT SCRIPT CHÍNH CỦA BẠN TẠI ĐÂY]
        else
            print("❌ Key sai hoặc kho tạm đã tự xóa sau 2 tiếng!")
        end
    -- end)
end

-- Khởi động hệ thống quét key
startKeySystem()
